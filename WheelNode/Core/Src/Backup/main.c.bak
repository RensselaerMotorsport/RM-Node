ADC_HandleTypeDef hadc;

CAN_HandleTypeDef hcan;

UART_HandleTypeDef huart2;

/* USER CODE BEGIN PV */
static uint16_t adc_buffer[3] = {0};
static uint8_t knob_positions[3] = {0};
static GPIO_TypeDef* button_ports[3] = {GPIOB, GPIOB, GPIOB};
static uint16_t button_pins[3] = {GPIO_PIN_6, GPIO_PIN_3, GPIO_PIN_5};

/* USER CODE END PV */

